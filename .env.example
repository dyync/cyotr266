# ---- copy to .env and fill in --------------------------------------------
# Public hostname (DNS A record -> this VM) for automatic HTTPS via Let's Encrypt.
# Use DOMAIN=":80" for plain HTTP on a trusted LAN.
DOMAIN=ai.example.com
PUBLIC_BASE_URL=https://ai.example.com

# Secrets: generate each with  openssl rand -hex 32
INTERNAL_TOKEN=change-me
REDIS_PASSWORD=change-me
# Bearer keys for the legacy POST /api endpoint (comma separated, empty = disabled)
API_KEYS=

# Hugging Face token (needed for gated models, avoids rate limits)
HF_TOKEN=

# Storage (host paths)
MODELS_DIR=/models
DATA_DIR=./data

# ---- models (defaults shown) ----------------------------------------------
# LLM_MODEL=RedHatAI/Qwen3.5-9B-FP8-dynamic
# LLM_MAX_MODEL_LEN=32768
# LLM_GPU_UTIL=0.78
# LLM_EXTRA_ARGS=--language-model-only --reasoning-parser qwen3 --enable-auto-tool-choice --tool-call-parser qwen3_coder
# IMAGE_MODEL=Tongyi-MAI/Z-Image-Turbo
# VIDEO_MODEL=Wan-AI/Wan2.2-TI2V-5B-Diffusers
# ASR_MODEL=large-v3-turbo

# ---- limits ----------------------------------------------------------------
# MAX_JOBS_PER_USER=2
# CHAT_RPM=30
